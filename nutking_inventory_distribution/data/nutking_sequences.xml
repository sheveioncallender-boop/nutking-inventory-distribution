<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="sequence_nutking_stock_operation" model="ir.sequence">
        <field name="name">Nut King Stock Operation</field>
        <field name="code">nutking.stock.operation</field>
        <field name="prefix">NK-OP-%(year)s-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_nutking_distribution_trip" model="ir.sequence">
        <field name="name">Nut King Distribution Trip</field>
        <field name="code">nutking.distribution.trip</field>
        <field name="prefix">NK-TRIP-%(year)s-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
