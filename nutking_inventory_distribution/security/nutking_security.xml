<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19 uses res.groups.privilege to organize application roles. -->
    <record id="res_groups_privilege_nutking" model="res.groups.privilege">
        <field name="name">Nut King Operations</field>
        <field name="sequence">35</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_nutking_user" model="res.groups">
        <field name="name">Operations User</field>
        <field name="comment">Access to the Nut King operations workspace.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_nutking"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_nutking_raw_clerk" model="res.groups">
        <field name="name">Raw Materials Clerk</field>
        <field name="comment">Receive, issue, count and review raw-material stock.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_nutking"/>
        <field name="implied_ids" eval="[(4, ref('group_nutking_user'))]"/>
    </record>
    <record id="group_nutking_finished_clerk" model="res.groups">
        <field name="name">Finished Goods Clerk</field>
        <field name="comment">Add, count, load and receive finished-goods stock.</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_nutking"/>
        <field name="implied_ids" eval="[(4, ref('group_nutking_user'))]"/>
    </record>
    <record id="group_nutking_distribution" model="res.groups">
        <field name="name">Distribution Team</field>
        <field name="comment">Use assigned trips, truck stock, deliveries and returns.</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_nutking"/>
        <field name="implied_ids" eval="[(4, ref('group_nutking_user'))]"/>
    </record>
    <record id="group_nutking_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="comment">Approve stock operations, reconcile trips and review variances.</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="res_groups_privilege_nutking"/>
        <field name="implied_ids" eval="[(4, ref('group_nutking_raw_clerk')), (4, ref('group_nutking_finished_clerk')), (4, ref('group_nutking_distribution'))]"/>
    </record>
    <record id="group_nutking_manager" model="res.groups">
        <field name="name">Management</field>
        <field name="comment">Executive dashboards, reports and complete Nut King operational visibility.</field>
        <field name="sequence">60</field>
        <field name="privilege_id" ref="res_groups_privilege_nutking"/>
        <field name="implied_ids" eval="[(4, ref('group_nutking_supervisor'))]"/>
    </record>

    <!-- During staging, every Odoo Settings administrator automatically receives
         Nut King Management access so the application is visible and testable.
         The final worker lock-down will later use a dedicated developer group. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('nutking_inventory_distribution.group_nutking_manager'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_nutking_operation_company" model="ir.rule">
            <field name="name">Nut King operations: company data</field>
            <field name="model_id" ref="model_nutking_stock_operation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nutking_user'))]"/>
        </record>

        <record id="rule_nutking_trip_company" model="ir.rule">
            <field name="name">Nut King trips: company data</field>
            <field name="model_id" ref="model_nutking_distribution_trip"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nutking_user'))]"/>
        </record>

        <record id="rule_nutking_truck_company" model="ir.rule">
            <field name="name">Nut King trucks: company data</field>
            <field name="model_id" ref="model_nutking_truck"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nutking_user'))]"/>
        </record>

        <record id="rule_nutking_offline_own" model="ir.rule">
            <field name="name">Nut King offline queue: own device transactions</field>
            <field name="model_id" ref="model_nutking_offline_transaction"/>
            <field name="domain_force">[('user_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nutking_user'))]"/>
        </record>

        <record id="rule_nutking_offline_supervisor" model="ir.rule">
            <field name="name">Nut King offline queue: supervisors see company queue</field>
            <field name="model_id" ref="model_nutking_offline_transaction"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nutking_supervisor'))]"/>
        </record>

        <record id="rule_nutking_quant_locations" model="ir.rule">
            <field name="name">Nut King users see only Nut King stock balances</field>
            <field name="model_id" ref="stock.model_stock_quant"/>
            <field name="domain_force">[('location_id.nutking_is_location', '=', True)]</field>
            <field name="groups" eval="[(4, ref('group_nutking_user'))]"/>
        </record>

        <record id="rule_nutking_picking_operations" model="ir.rule">
            <field name="name">Nut King users see only generated stock transfers</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">[('nutking_operation_id', '!=', False)]</field>
            <field name="groups" eval="[(4, ref('group_nutking_user'))]"/>
        </record>

        <record id="rule_nutking_product_variants" model="ir.rule">
            <field name="name">Nut King users see operational product variants</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="domain_force">[('nutking_inventory_type', 'in', ('raw_material', 'finished_good'))]</field>
            <field name="groups" eval="[(4, ref('group_nutking_user'))]"/>
        </record>

        <record id="rule_nutking_product_templates" model="ir.rule">
            <field name="name">Nut King users see operational product templates</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="domain_force">[('nutking_inventory_type', 'in', ('raw_material', 'finished_good'))]</field>
            <field name="groups" eval="[(4, ref('group_nutking_user'))]"/>
        </record>
    </data>
</odoo>
