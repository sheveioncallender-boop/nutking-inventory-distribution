<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_nutking_operation_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div style="border-top:8px solid #ef1b23;padding-top:14px;display:flex;justify-content:space-between;align-items:center;gap:20px;">
                            <div>
                                <h2 style="color:#17120f;margin:0;">Nut King Stock Operation</h2>
                                <p style="margin:4px 0;color:#6b625d;">Sesame Foods Limited</p>
                                <h3 style="margin:8px 0 0;" t-field="o.name"/>
                            </div>
                            <img src="/nutking_inventory_distribution/static/img/nutking_logo.png" style="max-width:180px;max-height:80px;" alt="The Nut Kings"/>
                        </div>

                        <div style="margin:14px 0;padding:10px 14px;border:1px solid #e5ddd5;border-radius:8px;background:#fff8df;">
                            <strong>Status: </strong><span t-field="o.state"/>
                            <span style="margin-left:24px;"><strong>Operation: </strong><span t-field="o.operation_type"/></span>
                        </div>

                        <table class="table table-sm">
                            <tbody>
                                <tr><th>Operation Date</th><td t-field="o.operation_date"/><th>Created By</th><td t-field="o.user_id"/></tr>
                                <tr><th>Supplier / Customer</th><td t-field="o.partner_id"/><th>Truck</th><td t-field="o.truck_id"/></tr>
                                <tr><th>Trip</th><td t-field="o.trip_id"/><th>Movement Reason</th><td t-field="o.reason_id"/></tr>
                                <tr><th>Source</th><td t-field="o.source_location_id"/><th>Destination</th><td t-field="o.destination_location_id"/></tr>
                                <tr><th>External Reference</th><td t-field="o.external_reference"/><th>Odoo Transfer</th><td t-field="o.picking_id"/></tr>
                            </tbody>
                        </table>

                        <table class="table table-sm table-bordered">
                            <thead style="background:#ffc928;">
                                <tr><th>Product</th><th>Barcode</th><th class="text-end">Quantity</th><th>UoM</th><th>Batch / Lot</th><th>Expiration</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td t-field="line.product_id"/>
                                    <td t-field="line.barcode"/>
                                    <td class="text-end" t-field="line.quantity"/>
                                    <td t-field="line.product_uom_id"/>
                                    <td t-field="line.lot_reference"/>
                                    <td t-field="line.expiration_date"/>
                                </tr>
                            </tbody>
                        </table>

                        <div style="margin-top:12px;">
                            <strong>Total Quantity:</strong> <span t-field="o.total_quantity"/>
                        </div>
                        <div style="margin-top:10px;" t-if="o.notes">
                            <strong>Notes:</strong> <span t-field="o.notes"/>
                        </div>
                        <div style="margin-top:28px;display:flex;justify-content:space-between;gap:40px;">
                            <div style="width:45%;border-top:1px solid #17120f;padding-top:6px;">Prepared / Processed By</div>
                            <div style="width:45%;border-top:1px solid #17120f;padding-top:6px;">Authorized Signature</div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_nutking_trip_document">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page">
            <div style="border-top:8px solid #ef1b23;padding-top:14px;display:flex;justify-content:space-between;align-items:center;"><div><h2 style="margin:0;">Nut King Distribution Trip</h2><p style="margin:4px 0;color:#6b625d;">Sesame Foods Limited</p><h3 t-field="o.name"/></div><img src="/nutking_inventory_distribution/static/img/nutking_logo.png" style="max-width:180px;max-height:70px;" alt="The Nut Kings"/></div>
            <table class="table table-sm"><tbody><tr><th>Truck</th><td t-field="o.truck_id"/></tr><tr><th>Driver</th><td t-field="o.driver_id"/></tr><tr><th>Route</th><td t-field="o.route_name"/></tr><tr><th>Departure</th><td t-field="o.actual_departure"/></tr><tr><th>Return</th><td t-field="o.actual_return"/></tr></tbody></table>
            <table class="table table-sm table-bordered"><thead style="background:#ffc928;"><tr><th>Product</th><th>Loaded</th><th>Delivered</th><th>Returned</th><th>Damaged</th><th>Variance</th></tr></thead><tbody><tr t-foreach="o.line_ids" t-as="line"><td t-field="line.product_id"/><td t-field="line.qty_loaded"/><td t-field="line.qty_delivered"/><td t-field="line.qty_returned"/><td t-field="line.qty_damaged"/><td t-field="line.variance"/></tr></tbody></table>
            <p><strong>Variance Explanation:</strong> <span t-field="o.variance_explanation"/></p>
        </div></t></t></t>
    </template>
</odoo>
