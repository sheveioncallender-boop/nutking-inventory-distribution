<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nutking_customer_list" model="ir.ui.view"><field name="name">nutking.customer.list</field><field name="model">res.partner</field><field name="arch" type="xml"><list><field name="name"/><field name="nutking_customer_code"/><field name="phone"/><field name="email"/><field name="nutking_route"/><field name="city"/><field name="active"/></list></field></record>
    <record id="view_nutking_customer_form" model="ir.ui.view"><field name="name">nutking.customer.form</field><field name="model">res.partner</field><field name="arch" type="xml"><form string="Nut King Customer"><sheet><field name="nutking_is_customer" invisible="1"/><div class="oe_title"><h1><field name="name"/></h1></div><group><group string="Customer"><field name="nutking_customer_code"/><field name="phone"/><field name="nutking_mobile"/><field name="email"/><field name="nutking_route"/></group><group string="Delivery Address"><field name="street"/><field name="street2"/><field name="city"/><field name="state_id"/><field name="country_id"/></group></group><group string="Delivery Instructions"><field name="nutking_delivery_notes" nolabel="1"/></group></sheet></form></field></record>
    <record id="action_nutking_customers" model="ir.actions.act_window"><field name="name">Customers</field><field name="res_model">res.partner</field><field name="view_mode">list,form</field><field name="domain">[('nutking_is_customer','=',True)]</field><field name="context">{'default_nutking_is_customer':True}</field><field name="views" eval="[(ref('view_nutking_customer_list'), 'list'), (ref('view_nutking_customer_form'), 'form')]"/></record>
</odoo>
