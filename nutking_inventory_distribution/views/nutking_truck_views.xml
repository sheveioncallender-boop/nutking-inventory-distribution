<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nutking_truck_list" model="ir.ui.view"><field name="name">nutking.truck.list</field><field name="model">nutking.truck</field><field name="arch" type="xml"><list decoration-success="status == 'available'" decoration-warning="status in ('loading','on_route')" decoration-muted="status in ('maintenance','inactive')"><field name="name"/><field name="registration_number"/><field name="barcode"/><field name="default_driver_id"/><field name="status" widget="badge"/><field name="stock_location_id"/><field name="active"/></list></field></record>
    <record id="view_nutking_truck_form" model="ir.ui.view"><field name="name">nutking.truck.form</field><field name="model">nutking.truck</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group string="Vehicle"><field name="registration_number"/><field name="barcode"/><field name="make"/><field name="model"/><field name="capacity_note"/></group><group string="Operations"><field name="status"/><field name="default_driver_id"/><field name="default_team_ids" widget="many2many_tags"/><field name="stock_location_id" readonly="1"/><field name="active"/></group></group><field name="notes"/></sheet><chatter/></form></field></record>
    <record id="action_nutking_trucks" model="ir.actions.act_window"><field name="name">Distribution Trucks</field><field name="res_model">nutking.truck</field><field name="view_mode">list,form</field></record>
</odoo>
