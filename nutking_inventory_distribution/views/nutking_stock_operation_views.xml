<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nutking_stock_operation_search" model="ir.ui.view"><field name="name">nutking.stock.operation.search</field><field name="model">nutking.stock.operation</field><field name="arch" type="xml"><search><field name="name"/><field name="operation_type"/><field name="partner_id"/><field name="truck_id"/><field name="trip_id"/><field name="user_id"/><filter name="pending" string="Pending" domain="[('state','in',('draft','confirmed'))]"/><filter name="completed" string="Completed" domain="[('state','=','done')]"/><group expand="0" string="Group By"><filter string="Operation" context="{'group_by':'operation_type'}"/><filter string="Status" context="{'group_by':'state'}"/><filter string="Truck" context="{'group_by':'truck_id'}"/><filter string="Date" context="{'group_by':'operation_date:month'}"/></group></search></field></record>
    <record id="view_nutking_stock_operation_list" model="ir.ui.view"><field name="name">nutking.stock.operation.list</field><field name="model">nutking.stock.operation</field><field name="arch" type="xml"><list decoration-success="state == 'done'" decoration-warning="state == 'confirmed'" decoration-muted="state == 'cancelled'"><field name="name"/><field name="operation_date"/><field name="operation_type"/><field name="partner_id"/><field name="truck_id"/><field name="trip_id"/><field name="total_quantity"/><field name="user_id"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_nutking_stock_operation_form" model="ir.ui.view"><field name="name">nutking.stock.operation.form</field><field name="model">nutking.stock.operation</field><field name="arch" type="xml"><form>
        <header>
            <button name="action_confirm" type="object" string="Confirm" class="oe_highlight" invisible="state != 'draft'"/>
            <button name="action_process" type="object" string="Process Stock Movement" class="oe_highlight" invisible="state != 'confirmed'" confirm="This will update Nut King inventory. Continue?"/>
            <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft','confirmed')"/>
            <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state != 'cancelled'"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
        </header>
        <sheet>
            <div class="oe_button_box" name="button_box"><button name="action_view_picking" type="object" class="oe_stat_button" icon="fa-exchange" invisible="not picking_id"><div class="o_stat_info"><span class="o_stat_text">Stock Transfer</span></div></button></div>
            <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
            <group><group><field name="operation_type" readonly="state != 'draft'"/><field name="operation_date" readonly="state == 'done'"/><field name="partner_id" invisible="operation_type not in ('raw_receipt','raw_supplier_return','customer_delivery','customer_return')" readonly="state != 'draft'"/><field name="truck_id" invisible="operation_type not in ('truck_load','customer_delivery','truck_return','finished_damage')" readonly="state != 'draft'"/><field name="trip_id" domain="[('state', 'in', ('planned', 'loading', 'in_progress', 'reconciliation'))]" required="operation_type in ('truck_load','customer_delivery','truck_return')" readonly="state == 'done'"/></group><group><field name="reason_id" invisible="operation_type not in ('raw_issue','raw_supplier_return','raw_damage','raw_expired','raw_adjustment','truck_return','customer_return','finished_damage','finished_adjustment')" readonly="state != 'draft'"/><field name="adjustment_direction" invisible="operation_type not in ('raw_adjustment','finished_adjustment')" readonly="state != 'draft'"/><field name="user_id" readonly="1"/><field name="source_location_id" readonly="1"/><field name="destination_location_id" readonly="1"/></group></group>
            <notebook><page string="Products"><field name="line_ids" readonly="state not in ('draft','confirmed')"><list editable="bottom"><field name="product_id"/><field name="barcode"/><field name="inventory_type"/><field name="quantity"/><field name="product_uom_id"/><field name="lot_reference"/><field name="expiration_date"/><field name="notes"/></list></field><div class="oe_right"><label for="total_quantity"/><field name="total_quantity" readonly="1"/></div></page><page string="Notes"><field name="notes" placeholder="Reason details, delivery notes, damage explanation, or other operational comments..."/></page><page string="Audit"><group><field name="picking_id" readonly="1"/><field name="offline_transaction_id" readonly="1"/></group></page></notebook>
        </sheet><chatter/></form></field></record>
    <record id="action_nutking_stock_operation" model="ir.actions.act_window"><field name="name">Stock Operations</field><field name="res_model">nutking.stock.operation</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_nutking_stock_operation_search"/></record>
    <record id="action_nutking_raw_operations" model="ir.actions.act_window"><field name="name">Raw Materials Movements</field><field name="res_model">nutking.stock.operation</field><field name="view_mode">list,form</field><field name="domain">[('operation_type','in',('raw_receipt','raw_issue','raw_supplier_return','raw_damage','raw_expired','raw_adjustment'))]</field></record>
    <record id="action_nutking_finished_operations" model="ir.actions.act_window"><field name="name">Finished Goods Movements</field><field name="res_model">nutking.stock.operation</field><field name="view_mode">list,form</field><field name="domain">[('operation_type','in',('finished_add','truck_load','customer_delivery','truck_return','customer_return','finished_damage','finished_adjustment'))]</field></record>
</odoo>
