<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nutking_trip_search" model="ir.ui.view"><field name="name">nutking.trip.search</field><field name="model">nutking.distribution.trip</field><field name="arch" type="xml"><search><field name="name"/><field name="truck_id"/><field name="driver_id"/><field name="route_name"/><filter string="Open" name="open" domain="[('state','not in',('done','cancelled'))]"/><filter string="Closed" name="closed" domain="[('state','=','done')]"/><group expand="0" string="Group By"><filter string="Truck" context="{'group_by':'truck_id'}"/><filter string="Driver" context="{'group_by':'driver_id'}"/><filter string="Status" context="{'group_by':'state'}"/><filter string="Month" context="{'group_by':'planned_departure:month'}"/></group></search></field></record>
    <record id="view_nutking_trip_list" model="ir.ui.view"><field name="name">nutking.trip.list</field><field name="model">nutking.distribution.trip</field><field name="arch" type="xml"><list decoration-success="state == 'done'" decoration-warning="state in ('loading','in_progress','reconciliation')"><field name="name"/><field name="planned_departure"/><field name="truck_id"/><field name="driver_id"/><field name="route_name"/><field name="total_loaded"/><field name="total_delivered"/><field name="total_returned"/><field name="total_variance" decoration-danger="total_variance != 0"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_nutking_trip_form" model="ir.ui.view"><field name="name">nutking.trip.form</field><field name="model">nutking.distribution.trip</field><field name="arch" type="xml"><form>
        <header><button name="action_create_load" type="object" string="Load Truck" class="oe_highlight" invisible="state not in ('planned','loading')"/><button name="action_depart" type="object" string="Confirm Departure" class="oe_highlight" invisible="state != 'loading'"/><button name="action_create_delivery" type="object" string="Record Delivery" invisible="state not in ('in_progress','reconciliation')"/><button name="action_create_return" type="object" string="Receive Return" invisible="state not in ('in_progress','reconciliation')"/><button name="action_start_reconciliation" type="object" string="Start Reconciliation" invisible="state != 'in_progress'"/><button name="action_approve_variance" type="object" string="Approve Variance" groups="nutking_inventory_distribution.group_nutking_supervisor" invisible="state != 'reconciliation' or total_variance == 0 or supervisor_approved"/><button name="action_close" type="object" string="Close Trip" class="oe_highlight" groups="nutking_inventory_distribution.group_nutking_supervisor" invisible="state != 'reconciliation'"/><button name="action_cancel" type="object" string="Cancel" invisible="state not in ('planned','loading')"/><field name="state" widget="statusbar" statusbar_visible="planned,loading,in_progress,reconciliation,done"/></header>
        <sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group string="Assignment"><field name="truck_id" readonly="state != 'planned'"/><field name="driver_id" readonly="state != 'planned'"/><field name="team_ids" widget="many2many_tags" readonly="state != 'planned'"/><field name="route_name" readonly="state != 'planned'"/></group><group string="Schedule"><field name="planned_departure"/><field name="actual_departure"/><field name="actual_return"/><field name="customer_ids" widget="many2many_tags"/></group></group>
        <div class="nk_trip_totals"><div><span>Loaded</span><field name="total_loaded" nolabel="1"/></div><div><span>Delivered</span><field name="total_delivered" nolabel="1"/></div><div><span>Returned</span><field name="total_returned" nolabel="1"/></div><div><span>Damaged</span><field name="total_damaged" nolabel="1"/></div><div class="nk_variance"><span>Variance</span><field name="total_variance" nolabel="1"/></div></div>
        <notebook><page string="Stock Operations"><field name="operation_ids" readonly="1"><list><field name="name"/><field name="operation_date"/><field name="operation_type"/><field name="partner_id"/><field name="total_quantity"/><field name="state" widget="badge"/></list></field></page><page string="Reconciliation"><field name="line_ids" readonly="1"><list><field name="product_id"/><field name="qty_loaded"/><field name="qty_delivered"/><field name="qty_returned"/><field name="qty_damaged"/><field name="variance" decoration-danger="variance != 0"/></list></field><group><field name="variance_explanation"/><field name="supervisor_approved" readonly="1"/></group></page><page string="Notes"><field name="notes"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_nutking_distribution_trip" model="ir.actions.act_window"><field name="name">Distribution Trips</field><field name="res_model">nutking.distribution.trip</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_nutking_trip_search"/></record>
</odoo>
