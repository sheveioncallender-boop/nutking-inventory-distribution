<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_nutking_stock_balance_list" model="ir.ui.view">
        <field name="name">nutking.stock.balance.list</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <list string="Nut King Stock Levels" create="0" edit="0" delete="0" decoration-danger="available_quantity &lt; 0">
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="lot_id" optional="hide"/>
                <field name="quantity" sum="Total On Hand"/>
                <field name="reserved_quantity" sum="Total Reserved" optional="hide"/>
                <field name="available_quantity" sum="Total Available"/>
                <field name="product_uom_id"/>
            </list>
        </field>
    </record>

    <record id="view_nutking_stock_balance_search" model="ir.ui.view">
        <field name="name">nutking.stock.balance.search</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <search string="Nut King Stock Levels">
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="lot_id"/>
                <filter string="Positive Stock" name="positive" domain="[('quantity', '&gt;', 0)]"/>
                <separator/><filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Location" name="group_location" context="{'group_by': 'location_id'}"/>
                </search>
        </field>
    </record>

    <record id="action_nutking_raw_stock_levels" model="ir.actions.act_window">
        <field name="name">Raw Materials Stock Levels</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="views" eval="[(ref('view_nutking_stock_balance_list'), 'list')]"/>
        <field name="search_view_id" ref="view_nutking_stock_balance_search"/>
        <field name="domain" eval="[('location_id', 'child_of', ref('location_rm_stock')), ('quantity', '!=', 0)]"/>
        <field name="context">{'search_default_positive': 1, 'search_default_group_product': 1}</field>
    </record>

    <record id="action_nutking_finished_stock_levels" model="ir.actions.act_window">
        <field name="name">Finished Goods Stock Levels</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="views" eval="[(ref('view_nutking_stock_balance_list'), 'list')]"/>
        <field name="search_view_id" ref="view_nutking_stock_balance_search"/>
        <field name="domain" eval="[('location_id', 'child_of', ref('location_fg_stock')), ('quantity', '!=', 0)]"/>
        <field name="context">{'search_default_positive': 1, 'search_default_group_product': 1}</field>
    </record>

    <record id="action_nutking_truck_stock_levels" model="ir.actions.act_window">
        <field name="name">Stock Currently on Trucks</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="views" eval="[(ref('view_nutking_stock_balance_list'), 'list')]"/>
        <field name="search_view_id" ref="view_nutking_stock_balance_search"/>
        <field name="domain" eval="[('location_id', 'child_of', ref('location_fg_trucks_root')), ('quantity', '!=', 0)]"/>
        <field name="context">{'search_default_positive': 1, 'search_default_group_location': 1}</field>
    </record>
</odoo>
