<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nutking_offline_list" model="ir.ui.view">
        <field name="name">nutking.offline.list</field>
        <field name="model">nutking.offline.transaction</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'processed'" decoration-danger="state == 'error'">
                <field name="external_uid"/>
                <field name="transaction_kind"/>
                <field name="device_name"/>
                <field name="created_on_device"/>
                <field name="received_at"/>
                <field name="user_id"/>
                <field name="operation_id" optional="show"/>
                <field name="trip_id" optional="show"/>
                <field name="result_reference" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="error_message" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_nutking_offline_form" model="ir.ui.view">
        <field name="name">nutking.offline.form</field>
        <field name="model">nutking.offline.transaction</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="external_uid"/>
                            <field name="transaction_kind"/>
                            <field name="device_name"/>
                            <field name="created_on_device"/>
                            <field name="received_at"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="state"/>
                            <field name="operation_id"/>
                            <field name="trip_id"/>
                            <field name="result_reference"/>
                        </group>
                    </group>
                    <group string="Error"><field name="error_message" nolabel="1"/></group>
                    <group string="Payload"><field name="payload" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nutking_offline_transactions" model="ir.actions.act_window">
        <field name="name">Offline Synchronization</field>
        <field name="res_model">nutking.offline.transaction</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Worker-facing application entry points. These run outside the Odoo web-client shell. -->
    <record id="action_nutking_workspace" model="ir.actions.act_url">
        <field name="name">Nut King Operations</field>
        <field name="url">/nutking/#dashboard</field>
        <field name="target">self</field>
    </record>
    <record id="action_nutking_workspace_raw" model="ir.actions.act_url">
        <field name="name">Raw Materials</field>
        <field name="url">/nutking/#raw</field>
        <field name="target">self</field>
    </record>
    <record id="action_nutking_workspace_finished" model="ir.actions.act_url">
        <field name="name">Finished Goods</field>
        <field name="url">/nutking/#finished</field>
        <field name="target">self</field>
    </record>
    <record id="action_nutking_workspace_distribution" model="ir.actions.act_url">
        <field name="name">Distribution</field>
        <field name="url">/nutking/#distribution</field>
        <field name="target">self</field>
    </record>
    <record id="action_nutking_workspace_inventory" model="ir.actions.act_url">
        <field name="name">Physical Inventory</field>
        <field name="url">/nutking/#inventory</field>
        <field name="target">self</field>
    </record>
    <record id="action_nutking_workspace_operations" model="ir.actions.act_url">
        <field name="name">Stock Operations</field>
        <field name="url">/nutking/#operations</field>
        <field name="target">self</field>
    </record>
    <record id="action_nutking_workspace_contacts" model="ir.actions.act_url">
        <field name="name">Contacts &amp; Trucks</field>
        <field name="url">/nutking/#contacts</field>
        <field name="target">self</field>
    </record>
    <record id="action_nutking_workspace_reports" model="ir.actions.act_url">
        <field name="name">Reports</field>
        <field name="url">/nutking/#reports</field>
        <field name="target">self</field>
    </record>
    <record id="action_nutking_offline_app" model="ir.actions.act_url">
        <field name="name">Synchronization</field>
        <field name="url">/nutking/#sync</field>
        <field name="target">self</field>
    </record>
</odoo>
