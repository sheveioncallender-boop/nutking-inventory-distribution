<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nutking_offline_list" model="ir.ui.view"><field name="name">nutking.offline.list</field><field name="model">nutking.offline.transaction</field><field name="arch" type="xml"><list decoration-success="state == 'processed'" decoration-danger="state == 'error'"><field name="external_uid"/><field name="device_name"/><field name="created_on_device"/><field name="received_at"/><field name="user_id"/><field name="operation_id"/><field name="state" widget="badge"/><field name="error_message"/></list></field></record>
    <record id="view_nutking_offline_form" model="ir.ui.view"><field name="name">nutking.offline.form</field><field name="model">nutking.offline.transaction</field><field name="arch" type="xml"><form create="0" edit="0"><sheet><group><group><field name="external_uid"/><field name="device_name"/><field name="created_on_device"/><field name="received_at"/></group><group><field name="user_id"/><field name="state"/><field name="operation_id"/></group></group><group string="Error"><field name="error_message" nolabel="1"/></group><group string="Payload"><field name="payload" nolabel="1"/></group></sheet></form></field></record>
    <record id="action_nutking_offline_transactions" model="ir.actions.act_window"><field name="name">Offline Synchronization</field><field name="res_model">nutking.offline.transaction</field><field name="view_mode">list,form</field></record>
    <record id="action_nutking_offline_app" model="ir.actions.act_url"><field name="name">Offline Operations App</field><field name="url">/nutking/offline</field><field name="target">self</field></record>
</odoo>
