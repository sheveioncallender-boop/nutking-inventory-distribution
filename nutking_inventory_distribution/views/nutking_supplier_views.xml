<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nutking_supplier_list" model="ir.ui.view">
        <field name="name">nutking.supplier.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Raw-Material Suppliers">
                <field name="name"/>
                <field name="nutking_supplier_code"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="city"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_nutking_supplier_form" model="ir.ui.view">
        <field name="name">nutking.supplier.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Nut King Raw-Material Supplier">
                <sheet>
                    <field name="nutking_is_supplier" invisible="1"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Supplier">
                            <field name="nutking_supplier_code"/>
                            <field name="phone"/>
                            <field name="mobile"/>
                            <field name="email"/>
                        </group>
                        <group string="Address">
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="city"/>
                            <field name="state_id"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_nutking_suppliers" model="ir.actions.act_window">
        <field name="name">Raw-Material Suppliers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('nutking_is_supplier', '=', True)]</field>
        <field name="context">{'default_nutking_is_supplier': True, 'default_supplier_rank': 1}</field>
        <field name="views" eval="[(ref('view_nutking_supplier_list'), 'list'), (ref('view_nutking_supplier_form'), 'form')]"/>
    </record>
</odoo>
