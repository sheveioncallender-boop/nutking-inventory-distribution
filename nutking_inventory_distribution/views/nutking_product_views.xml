<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nutking_product_list" model="ir.ui.view">
        <field name="name">nutking.product.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Nut King Products" decoration-muted="not nutking_active">
                <field name="name"/>
                <field name="default_code" string="SKU"/>
                <field name="barcode"/>
                <field name="nutking_inventory_type"/>
                <field name="nutking_pack_size"/>
                <field name="nutking_units_per_case"/>
                <field name="nutking_minimum_qty"/>
                <field name="uom_id"/>
                <field name="nutking_active"/>
            </list>
        </field>
    </record>
    <record id="view_nutking_product_form" model="ir.ui.view">
        <field name="name">nutking.product.form</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <form string="Nut King Product">
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Inventory Identity">
                            <field name="nutking_inventory_type"/>
                            <field name="default_code" string="SKU"/>
                            <field name="barcode"/>
                            <field name="uom_id"/>
                            <field name="is_storable" invisible="1"/>
                        </group>
                        <group string="Nut King Details">
                            <field name="nutking_pack_size"/>
                            <field name="nutking_units_per_case"/>
                            <field name="nutking_minimum_qty"/>
                            <field name="nutking_active"/>
                        </group>
                    </group>
                    <notebook><page string="Notes"><field name="description"/></page></notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_nutking_raw_products" model="ir.actions.act_window">
        <field name="name">Raw Materials</field><field name="res_model">product.template</field><field name="view_mode">list,form</field>
        <field name="domain">[('nutking_inventory_type','=','raw_material')]</field>
        <field name="context">{'default_nutking_inventory_type':'raw_material','default_is_storable':True}</field>
        <field name="views" eval="[(ref('view_nutking_product_list'), 'list'), (ref('view_nutking_product_form'), 'form')]"/>
    </record>
    <record id="action_nutking_finished_products" model="ir.actions.act_window">
        <field name="name">Finished Goods</field><field name="res_model">product.template</field><field name="view_mode">list,form</field>
        <field name="domain">[('nutking_inventory_type','=','finished_good')]</field>
        <field name="context">{'default_nutking_inventory_type':'finished_good','default_is_storable':True}</field>
        <field name="views" eval="[(ref('view_nutking_product_list'), 'list'), (ref('view_nutking_product_form'), 'form')]"/>
    </record>
</odoo>
