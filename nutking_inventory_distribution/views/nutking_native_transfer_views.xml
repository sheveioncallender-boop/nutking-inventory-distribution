<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_form_nutking" model="ir.ui.view">
        <field name="name">stock.picking.form.nutking.hybrid</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority" eval="999"/>
        <field name="arch" type="xml">
            <!--
                Use a dedicated Nut King routing block for Nut King transfers.
                This is deliberately anchored to Odoo's top transfer-details
                group rather than to individual fields, because Enterprise and
                other stock extensions can reposition or override those fields.
            -->
            <xpath expr="//sheet/group[group/field[@name='picking_type_id']]" position="attributes">
                <attribute name="invisible" add="nutking_is_operation" separator=" or "/>
            </xpath>

            <xpath expr="//sheet/div[contains(concat(' ', normalize-space(@class), ' '), ' oe_title ')]" position="after">
                <field name="nutking_is_operation" invisible="1"/>
                <field name="nutking_operation_kind" invisible="1"/>
                <field name="picking_type_code" invisible="1"/>
                <field name="is_date_editable" invisible="1"/>

                <group name="nutking_transfer_routing" invisible="not nutking_is_operation">
                    <group string="Transfer Details">
                        <field name="partner_id"
                               string="Customer / Company / Supplier"
                               placeholder="Select an existing contact"
                               readonly="state in ['cancel', 'done']"
                               options="{'no_create_edit': False}"/>
                        <field name="picking_type_id"
                               string="Operation Type"
                               options="{'no_open': True, 'no_create': True}"
                               readonly="state in ('done', 'cancel')"
                               domain="[('code', 'in', ('incoming', 'outgoing', 'internal'))]"/>
                        <field name="location_id"
                               string="Source Location"
                               options="{'no_create': True}"
                               readonly="state in ['done', 'cancel']"
                               domain="[('usage', '!=', 'view')]"/>
                        <field name="location_dest_id"
                               string="Destination Location"
                               options="{'no_create': True}"
                               readonly="state in ['done', 'cancel']"
                               domain="[('usage', '!=', 'view')]"/>
                        <field name="backorder_id" invisible="not backorder_id" readonly="1"/>
                        <field name="use_create_lots" invisible="1"/>
                    </group>

                    <group string="Schedule &amp; Distribution">
                        <field name="scheduled_date"
                               string="Scheduled Date"
                               readonly="not is_date_editable"
                               required="id"
                               decoration-warning="state not in ('done', 'cancel') and scheduled_date &lt; now"
                               decoration-danger="state not in ('done', 'cancel') and scheduled_date &lt; current_date"
                               decoration-bf="state not in ('done', 'cancel') and (scheduled_date &lt; current_date or scheduled_date &lt; now)"/>
                        <field name="products_availability_state" invisible="1"/>
                        <field name="products_availability"
                               string="Availability"
                               invisible="picking_type_code not in ('outgoing', 'internal') or state not in ['confirmed', 'waiting', 'assigned']"
                               decoration-success="state == 'assigned' or products_availability_state == 'available'"
                               decoration-warning="state != 'assigned' and products_availability_state in ('expected', 'available')"
                               decoration-danger="state != 'assigned' and products_availability_state == 'late'"/>
                        <field name="date_done"
                               string="Effective Date"
                               invisible="state != 'done'"
                               readonly="not is_date_editable"/>
                        <field name="origin"
                               string="Source Document"
                               placeholder="e.g. delivery note or supplier invoice"
                               readonly="state in ['cancel', 'done']"/>
                        <field name="nutking_truck_id"
                               string="Truck"
                               options="{'no_create': True}"
                               readonly="state in ['done', 'cancel']"
                               invisible="nutking_operation_kind not in ['finished_issue', 'truck_load', 'customer_delivery', 'truck_return']"/>
                        <field name="nutking_trip_id"
                               string="Trip Number"
                               options="{'no_create': True}"
                               readonly="state in ['done', 'cancel']"
                               invisible="nutking_operation_kind not in ['finished_issue', 'truck_load', 'customer_delivery', 'truck_return']"/>
                        <field name="nutking_reason_id"
                               string="Movement Reason"
                               options="{'no_create': True}"
                               readonly="state in ['done', 'cancel']"
                               invisible="nutking_operation_kind != 'truck_return'"/>
                        <field name="nutking_source_reference"
                               string="Nut King Reference"
                               readonly="state in ['done', 'cancel']"
                               invisible="not nutking_source_reference"/>
                    </group>
                </group>
            </xpath>

            <!-- Keep Odoo's own location fields hidden only for Nut King records,
                 because the complete routing block above displays both fields
                 regardless of receipt/internal/delivery operation type. -->
            <xpath expr="//field[@name='location_id' and @groups='stock.group_stock_multi_locations']" position="attributes">
                <attribute name="invisible" add="nutking_is_operation" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='location_dest_id' and @groups='stock.group_stock_multi_locations']" position="attributes">
                <attribute name="invisible" add="nutking_is_operation" separator=" or "/>
            </xpath>

            <!-- Nut King uses the real Odoo states, with one consistent visible
                 path for receipts, internal transfers, and deliveries. -->
            <xpath expr="//field[@name='state' and @widget='statusbar']" position="attributes">
                <attribute name="invisible" add="nutking_is_operation" separator=" or "/>
            </xpath>
            <xpath expr="//header" position="inside">
                <field name="state"
                       widget="statusbar"
                       invisible="not nutking_is_operation"
                       statusbar_visible="draft,confirmed,assigned,done"/>
            </xpath>

            <xpath expr="//page[@name='extra']" position="inside">
                <group string="Nut King Audit" invisible="not nutking_is_operation">
                    <field name="nutking_offline_uid" readonly="1"/>
                    <field name="nutking_device_name" readonly="1"/>
                    <field name="nutking_created_offline" readonly="1"/>
                    <field name="nutking_operation_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_stock_picking_search_nutking" model="ir.ui.view">
        <field name="name">stock.picking.search.nutking.hybrid</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="nutking_operation_kind"/>
                <field name="nutking_truck_id"/>
                <field name="nutking_trip_id"/>
            </xpath>
            <xpath expr="//filter[@name='status']" position="before">
                <filter string="Nut King Transfers" name="nutking_transfers" domain="[('nutking_is_operation', '=', True)]"/>
                <filter string="Customer / Company" name="group_nutking_partner" context="{'group_by': 'partner_id'}"/>
                <filter string="Truck" name="group_nutking_truck" context="{'group_by': 'nutking_truck_id'}"/>
                <filter string="Trip" name="group_nutking_trip" context="{'group_by': 'nutking_trip_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_nutking_native_transfers" model="ir.actions.act_window">
        <field name="name">Nut King Transfers</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,kanban,form,calendar</field>
        <field name="domain">[('nutking_is_operation', '=', True)]</field>
        <field name="context">{'contact_display': 'partner_address', 'search_default_nutking_transfers': 1}</field>
        <field name="search_view_id" ref="stock.view_picking_internal_search"/>
    </record>
</odoo>
