<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_nutking_operation_line_search" model="ir.ui.view">
        <field name="name">nutking.stock.operation.line.analysis.search</field>
        <field name="model">nutking.stock.operation.line</field>
        <field name="arch" type="xml">
            <search string="Stock Movement Analysis">
                <field name="product_id"/><field name="operation_type"/><field name="truck_id"/><field name="partner_id"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'done')]"/>
                <separator/><filter string="Product" name="product" context="{'group_by':'product_id'}"/>
                    <filter string="Operation" name="operation" context="{'group_by':'operation_type'}"/>
                    <filter string="Month" name="month" context="{'group_by':'operation_date:month'}"/>
                    <filter string="Truck" name="truck" context="{'group_by':'truck_id'}"/>
                </search>
        </field>
    </record>
    <record id="view_nutking_operation_line_list" model="ir.ui.view">
        <field name="name">nutking.stock.operation.line.analysis.list</field>
        <field name="model">nutking.stock.operation.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="operation_date"/><field name="operation_id"/><field name="operation_type"/>
                <field name="product_id"/><field name="quantity" sum="Total Quantity"/><field name="product_uom_id"/>
                <field name="truck_id" optional="show"/><field name="trip_id" optional="hide"/><field name="partner_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_nutking_operation_graph" model="ir.ui.view">
        <field name="name">nutking.stock.operation.line.graph</field>
        <field name="model">nutking.stock.operation.line</field>
        <field name="arch" type="xml">
            <graph string="Stock Movement by Product" type="bar" sample="1">
                <field name="product_id"/>
                <field name="operation_type"/>
                <field name="quantity" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_nutking_operation_pivot" model="ir.ui.view">
        <field name="name">nutking.stock.operation.line.pivot</field>
        <field name="model">nutking.stock.operation.line</field>
        <field name="arch" type="xml">
            <pivot string="Stock Movement by Product" sample="1">
                <field name="operation_date" type="row" interval="month"/>
                <field name="product_id" type="row"/>
                <field name="operation_type" type="col"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_nutking_operation_analysis" model="ir.actions.act_window">
        <field name="name">Stock Movement Analysis</field>
        <field name="res_model">nutking.stock.operation.line</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="domain">[('state', '=', 'done')]</field>
        <field name="views" eval="[(ref('view_nutking_operation_graph'), 'graph'), (ref('view_nutking_operation_pivot'), 'pivot'), (ref('view_nutking_operation_line_list'), 'list')]"/>
        <field name="search_view_id" ref="view_nutking_operation_line_search"/>
        <field name="context">{'search_default_completed': 1}</field>
    </record>

    <record id="view_nutking_trip_graph" model="ir.ui.view">
        <field name="name">nutking.distribution.trip.graph</field>
        <field name="model">nutking.distribution.trip</field>
        <field name="arch" type="xml">
            <graph string="Distribution Performance" type="bar" sample="1">
                <field name="truck_id"/>
                <field name="total_loaded" type="measure"/>
                <field name="total_delivered" type="measure"/>
                <field name="total_returned" type="measure"/>
                <field name="total_variance" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_nutking_trip_pivot" model="ir.ui.view">
        <field name="name">nutking.distribution.trip.pivot</field>
        <field name="model">nutking.distribution.trip</field>
        <field name="arch" type="xml">
            <pivot string="Distribution Performance" sample="1">
                <field name="planned_departure" type="row" interval="month"/>
                <field name="truck_id" type="row"/>
                <field name="route_name" type="col"/>
                <field name="total_loaded" type="measure"/>
                <field name="total_delivered" type="measure"/>
                <field name="total_returned" type="measure"/>
                <field name="total_variance" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_nutking_trip_analysis" model="ir.actions.act_window">
        <field name="name">Distribution Performance</field>
        <field name="res_model">nutking.distribution.trip</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="domain">[('state', '=', 'done')]</field>
        <field name="views" eval="[(ref('view_nutking_trip_graph'), 'graph'), (ref('view_nutking_trip_pivot'), 'pivot'), (ref('view_nutking_trip_list'), 'list')]"/>
    </record>
</odoo>
